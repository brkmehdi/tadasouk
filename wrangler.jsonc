{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smallstore",
	// Cloudflare account "Meta Hackaton"
	"account_id": "d57fb66226e5bda27248ba2c4d62077a",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	// Supabase Postgres (project SmallStore, Frankfurt) through the pooler, as the role
	// smallstore_worker; caching off. In `npm run dev` the same binding points at the local stack.
	// Product photos (cutouts, studio and AI photos), written by /api/media, served by /media/...
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "smallstore-media" }],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "054070f374924a0ab5733220486cedf3",
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
		}
	],
	"vars": {
		"MODEL_API_BASE": "https://api.meta.ai/v1",
		"R2_BUCKET_NAME": "smallstore-media",
		// Hard spending caps in US dollars, checked before every Meta Model API call.
		"AI_FREE_DAILY_USD": "0",
		"DAILY_CAP_USD": "10.00"
	}
}
