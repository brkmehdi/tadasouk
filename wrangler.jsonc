{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hanout",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	"vars": {
		"MODEL_API_BASE": "https://api.meta.ai/v1",
		"R2_BUCKET_NAME": "hanout-media",
		// Hard spending caps in US dollars, checked before every Meta Model API call.
		"SESSION_CAP_USD": "0.50",
		"DAILY_CAP_USD": "5.00"
	},
	"r2_buckets": [
		{
			// Raw capture videos, SAM cutouts, generated images. Browser uploads with signed URLs.
			"binding": "MEDIA",
			"bucket_name": "hanout-media"
		}
	]
}
