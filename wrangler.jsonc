{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smallstore",
	// Cloudflare account "Meta Hackaton"
	"account_id": "d57fb66226e5bda27248ba2c4d62077a",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	"vars": {
		"MODEL_API_BASE": "https://api.meta.ai/v1",
		"R2_BUCKET_NAME": "smallstore-media",
		// Hard spending caps in US dollars, checked before every Meta Model API call.
		"AI_FREE_DAILY_USD": "0.50",
		"DAILY_CAP_USD": "10.00"
	}
}
