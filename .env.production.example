# Copy to .env.production (not committed) for production builds.
# Supabase project for sign-in in the browser. The publishable key only allows what the row level
# security policies allow (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your publishable key, sb_publishable_...>
