{
  "name": "SmallStore",
  "base_url": "http://localhost:3001",
  "live_url": "https://smallstore.smallstore-app.workers.dev",
  "locale": "fr-FR",
  "devices": ["mobile", "desktop"],
  "pages": [
    { "name": "sign-in", "path": "/connexion" },
    { "name": "not-found", "path": "/cette-page-n-existe-pas", "status": 404 }
  ],
  "overlays": [],
  "hide": [],
