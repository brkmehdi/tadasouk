# Local secrets for `npm run dev` and `npm run preview`. Copy to .dev.vars (git-ignored).
# In production these are Cloudflare secrets: `npx wrangler secret put MODEL_API_KEY`.

# Meta Model API key (dev.meta.ai). Server only, never sent to the browser.
MODEL_API_KEY=

# R2 S3-compatible credentials, used only to sign short-lived upload URLs.
# Dashboard > R2 > Manage API tokens > Create token (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
