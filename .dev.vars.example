# Local secrets for `npm run dev` and `npm run preview`. Copy to .dev.vars (git-ignored).
# In production these are Cloudflare secrets: `npx wrangler secret put MODEL_API_KEY`.

# Meta Model API key (dev.meta.ai). Server only, never sent to the browser.
MODEL_API_KEY=

# R2 S3-compatible credentials, used only to sign short-lived upload URLs.
# Dashboard > R2 > Manage API tokens > Create token (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Postgres for the server in `npm run dev`: the local Supabase stack (`npx supabase start`).
# In production the HYPERDRIVE binding in wrangler.jsonc replaces it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Signs the codes Supabase hands to /api/auth/sms-hook ("v1,whsec_..."). Same value as in
# supabase/.env locally, and as the hook secret in the Supabase dashboard in production.
SEND_SMS_HOOK_SECRET=
